# Local Development Database (used by sqlx)
DATABASE_URL="postgres://postgres:password@localhost:5432/newsletter"

# Azure Deployment Variables (used with envsubst and containerapp.yaml)
ACR_NAME="<your-acr-registry-name>"
ACR_PASSWORD="<your-acr-admin-password>"
DB_HOST="<your-postgres-server-name>"
DB_PASSWORD="<your-postgres-admin-password>"
IMAGE_TAG="latest"
APP_URL="https://<your-containerapp-fqdn>"

